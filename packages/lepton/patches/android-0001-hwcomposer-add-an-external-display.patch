     xdg_wm_base_ping,
 };
 
+// The external display's touch goes out through the tablet pipe as a single
+// touch point. The reader associates that device with the external display,
+// and scales the pipe's axis range (the primary display's size) onto it.
+static void
+ext_touch_write(struct display *d, wl_fixed_t x_w, wl_fixed_t y_w, int contact)
+{
+    struct input_event event[6];
+    struct timespec rt;
+    unsigned int res, n = 0;
+
+    if (ensure_pipe(d, INPUT_TABLET))
+        return;
+
+    if (clock_gettime(CLOCK_MONOTONIC, &rt) == -1) {
+        ALOGE("%s:%d error in touch clock_gettime: %s",
+              __FILE__, __LINE__, strerror(errno));
+    }
+
+    if (contact) {
+        int x = wl_fixed_to_double(x_w) * d->ext_abs_width / std::max(d->width, 1);
+        int y = wl_fixed_to_double(y_w) * d->ext_abs_height / std::max(d->height, 1);
+        ADD_EVENT(EV_ABS, ABS_X, std::clamp(x, 0, d->ext_abs_width));
+        ADD_EVENT(EV_ABS, ABS_Y, std::clamp(y, 0, d->ext_abs_height));
+    }
+    if (contact != 2) {
+        ADD_EVENT(EV_ABS, ABS_PRESSURE, contact ? 255 : 0);
+        ADD_EVENT(EV_KEY, BTN_TOOL_FINGER, contact);
+        ADD_EVENT(EV_KEY, BTN_TOUCH, contact);
+    }
+    ADD_EVENT(EV_SYN, SYN_REPORT, 0);
+
+    res = write(d->input_fd[INPUT_TABLET], &event, n * sizeof(event[0]));
+    if (res < n * sizeof(event[0]))
+        ALOGE("Failed to write event for InputFlinger: %s", strerror(errno));
+}
+
+static void
+ext_touch_handle_down(void *data, struct wl_touch *, uint32_t, uint32_t,
+                      struct wl_surface *, int32_t id, wl_fixed_t x_w, wl_fixed_t y_w)
+{
+    struct display *d = (struct display *)data;
+    if (d->ext_touch_id != -1)
+        return;
+    d->ext_touch_id = id;
+    ext_touch_write(d, x_w, y_w, 1);
+}
+
+static void
+ext_touch_handle_up(void *data, struct wl_touch *, uint32_t, uint32_t, int32_t id)
+{
+    struct display *d = (struct display *)data;
+    if (d->ext_touch_id != id)
+        return;
+    d->ext_touch_id = -1;
+    ext_touch_write(d, 0, 0, 0);
+}
+
+static void
+ext_touch_handle_motion(void *data, struct wl_touch *, uint32_t, int32_t id,
+                        wl_fixed_t x_w, wl_fixed_t y_w)
+{
+    struct display *d = (struct display *)data;
+    if (d->ext_touch_id != id)
+        return;
+    ext_touch_write(d, x_w, y_w, 2);
+}
+
+static void
+ext_touch_handle_frame(void *, struct wl_touch *)
+{
+}
+
+static void
+ext_touch_handle_cancel(void *data, struct wl_touch *)
+{
+    struct display *d = (struct display *)data;
+    if (d->ext_touch_id == -1)
+        return;
+    d->ext_touch_id = -1;
+    ext_touch_write(d, 0, 0, 0);
+}
+
+static void
+ext_touch_handle_shape(void *, struct wl_touch *, int32_t, wl_fixed_t, wl_fixed_t)
+{
+}
+
+static void
+ext_touch_handle_orientation(void *, struct wl_touch *, int32_t, wl_fixed_t)
+{
+}
+
+static const struct wl_touch_listener ext_touch_listener = {
+    ext_touch_handle_down,
+    ext_touch_handle_up,
+    ext_touch_handle_motion,
+    ext_touch_handle_frame,
+    ext_touch_handle_cancel,
+    ext_touch_handle_shape,
+    ext_touch_handle_orientation,
+};
+
+static void
+ext_seat_handle_capabilities(void *data, struct wl_seat *seat, uint32_t wl_caps)
+{
+    struct display *d = (struct display *)data;
+
+    if ((wl_caps & WL_SEAT_CAPABILITY_TOUCH) && !d->touch) {
+        d->touch = wl_seat_get_touch(seat);
+        d->input_fd[INPUT_TABLET] = -1;
+        d->ext_touch_id = -1;
+        mkfifo(INPUT_PIPE_NAME[INPUT_TABLET], S_IRWXO | S_IRWXG | S_IRWXU);
+        chown(INPUT_PIPE_NAME[INPUT_TABLET], 1000, 1000);
+        wl_touch_add_listener(d->touch, &ext_touch_listener, d);
+    } else if (!(wl_caps & WL_SEAT_CAPABILITY_TOUCH) && d->touch) {
+        wl_touch_destroy(d->touch);
+        d->touch = NULL;
+    }
+}
+
+static void
+ext_seat_handle_name(void *, struct wl_seat *, const char *)
+{
+}
+
+static const struct wl_seat_listener ext_seat_listener = {
+    ext_seat_handle_capabilities,
+    ext_seat_handle_name,
+};
+
 static void
 seat_handle_capabilities(void *data, struct wl_seat *seat, uint32_t wl_caps)
 {
@@ -1878,6 +2010,10 @@ registry_handle_global(void *data, struct wl_registry *registry,
     } else if(strcmp(interface, "wl_shell") == 0) {
         d->shell = (struct wl_shell *)wl_registry_bind(
                 registry, id, &wl_shell_interface, 1);
+    } else if (strcmp(interface, "wl_seat") == 0 && d->secondary) {
+        d->seat = (struct wl_seat*)wl_registry_bind(registry, id,
+                &wl_seat_interface, std::min(version, (uint32_t)WL_POINTER_AXIS_SOURCE_SINCE_VERSION));
+        wl_seat_add_listener(d->seat, &ext_seat_listener, d);
     } else if (strcmp(interface, "wl_seat") == 0) {
         d->seat = (struct wl_seat*)wl_registry_bind(registry, id,
                 &wl_seat_interface, std::min(version, (uint32_t)WL_POINTER_AXIS_SOURCE_SINCE_VERSION));
@@ -1919,7 +2055,7 @@ registry_handle_global(void *data, struct wl_registry *registry,
     } else if (strcmp(interface, "zwp_tablet_manager_v2") == 0) {
         d->tablet_manager = (struct zwp_tablet_manager_v2 *)wl_registry_bind(registry, id,
                 &zwp_tablet_manager_v2_interface, 1);
-        if (d->tablet_manager && d->seat)
+        if (d->tablet_manager && d->seat && !d->secondary)
             add_tablet_seat(d);
     } else if (strcmp(interface, "zwp_pointer_constraints_v1") == 0) {
         d->pointer_constraints = (struct zwp_pointer_constraints_v1 *)wl_registry_bind(
@@ -1936,7 +2072,7 @@ registry_handle_global(void *data, struct wl_registry *registry,
     } else if (strcmp(interface, wl_data_device_manager_interface.name) == 0) {
         d->data_device_manager = (struct wl_data_device_manager *)wl_registry_bind(registry, id,
                 &wl_data_device_manager_interface, std::min(version,  3U));
-        if (d->data_device_manager && d->seat)
+        if (d->data_device_manager && d->seat && !d->secondary)
             d->data_device = wl_data_device_manager_get_data_device(d->data_device_manager, d->seat);
     } else if (strcmp(interface, "gtk_shell1") == 0) {
         if (version < 6)
@@ -2026,13 +2162,14 @@ void open_windows::erase(const key_type& key) {
 }
 
 struct display *
-create_display(const char *gralloc)
+create_display(const char *gralloc, bool secondary)
 {
