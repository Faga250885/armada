+// Unmapped while no app draws here, so the second compositor can show its own content.
+static bool show_external(waydroid_hwc_composer_device_1 *pdev, bool content) {
+    window *win = pdev->ext_window.get();
+
+    if (!content) {
+        if (!pdev->ext_hidden) {
+            win->unmap();
+            pdev->ext_hidden = true;
+        }
+        return false;
+    }
+    if (pdev->ext_hidden) {
+        win->request_map();
+        // An unchanged frame is not presented again, so it waits for the configure
+        while (!win->configured)
+            usleep(1000);
+        wl_surface_attach(win->surface, win->bg_buffer, 0, 0);
+        wl_surface_damage(win->surface, 0, 0, INT32_MAX, INT32_MAX);
+        pdev->ext_hidden = false;
+    }
+    return true;
+}
+
+static void set_external(waydroid_hwc_composer_device_1 *pdev, hwc_display_contents_1_t *contents) {
+    struct display *d = pdev->ext_display;
+    window *win = pdev->ext_window.get();
+
+    if (contents->flags & HWC_GEOMETRY_CHANGED)
+        d->buffer_map.clear();
+
+    // Color layers have no buffer.
+    bool content = false;
+    for (size_t i = 0; i < contents->numHwLayers; i++) {
+        if (contents->hwLayers[i].compositionType != HWC_FRAMEBUFFER_TARGET && contents->hwLayers[i].handle)
+            content = true;
+    }
+    bool shown = show_external(pdev, content);
+
+    for (size_t i = 0; i < contents->numHwLayers; i++) {
+        hwc_layer_1_t *layer = &contents->hwLayers[i];
+        layer->releaseFenceFd = -1;
+
+        if (shown && layer->compositionType == HWC_FRAMEBUFFER_TARGET && layer->handle) {
+            win->reset_per_set_state();
+            // closes the acquire fence
+            apply_hwc_layer_to_surface_context(pdev, layer, i, win->get_next_layer(), nullptr, d);
+            wl_surface_commit(win->surface);
+        } else if (layer->acquireFenceFd != -1) {
+            close(layer->acquireFenceFd);
+        }
+        layer->acquireFenceFd = -1;
+    }
+    wl_display_flush(d->display);
+}
