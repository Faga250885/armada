From: virtudude <virtudude@protonmail.com>
Subject: [PATCH] hwcomposer: add an external display on a second compositor

The HAL drives one display on one Wayland connection. Dual-screen
handhelds have a second panel with its own compositor, and Android apps
reach a second screen through the external display and the Presentation
API.

When waydroid.wayland_display_ext names a socket, open a second
connection to it with one fullscreen toplevel and report it as
HWC_DISPLAY_EXTERNAL, hotplugged once the client has registered its
callbacks. SurfaceFlinger composites that display; its framebuffer target
is what gets presented.

The second connection binds the seat for touch only. EventHub has a
fixed list of input pipes and all of them belong to the primary display,
so the first touch point is written to the otherwise unused tablet pipe,
scaled to the axis range EventHub reports for it. An input device
configuration file for wayland_tablet associates it with the external
display.

---
diff --git a/hwcomposer/hwcomposer.cpp b/hwcomposer/hwcomposer.cpp
index ca0d5ad..5836b01 100644
--- a/hwcomposer/hwcomposer.cpp
+++ b/hwcomposer/hwcomposer.cpp
@@ -203,6 +203,15 @@ static int hwc_prepare(hwc_composer_device_1_t* dev,
     hwc_display_contents_1_t *contents = displays[HWC_DISPLAY_PRIMARY];
     assert(contents);
 
+    // SurfaceFlinger composites the external display; only its target is presented
+    if (pdev->ext_display && numDisplays > HWC_DISPLAY_EXTERNAL && displays[HWC_DISPLAY_EXTERNAL]) {
+        hwc_display_contents_1_t *ext = displays[HWC_DISPLAY_EXTERNAL];
+        for (size_t i = 0; i < ext->numHwLayers; i++) {
+            if (ext->hwLayers[i].compositionType != HWC_FRAMEBUFFER_TARGET)
+                ext->hwLayers[i].compositionType = HWC_FRAMEBUFFER;
+        }
+    }
+
     pdev->selected_mode = select_mode(pdev, contents);
     if (pdev->selected_mode->setup_prepare(pdev, contents) != 0) {
         return -1;
@@ -443,6 +452,58 @@ static void reset_per_commit_state_window(waydroid_hwc_composer_device_1 *pdev)
     }
 }
 
+static void set_external(waydroid_hwc_composer_device_1 *pdev, hwc_display_contents_1_t *contents) {
+    constexpr int acquireWarningMS = 100;
+    struct display *d = pdev->ext_display;
+    window *win = pdev->ext_window.get();
+
+    contents->retireFenceFd = -1;
+    for (size_t i = 0; i < contents->numHwLayers; i++) {
+        hwc_layer_1_t *layer = &contents->hwLayers[i];
+        layer->releaseFenceFd = -1;
+
+        if (layer->compositionType == HWC_FRAMEBUFFER_TARGET && layer->handle) {
+            auto metadata = pdev->gralloc_handler.get_buffer_metadata(d, layer, i);
+            buffer *buf = nullptr;
+            auto it = d->buffer_map.find(layer->handle);
+            if (it != d->buffer_map.end() && !(it->second->metadata != metadata)) {
+                buf = it->second.get();
+            } else {
+                if (it != d->buffer_map.end())
+                    d->buffer_map.erase(it);
+                auto created = pdev->gralloc_handler.create_buffer(d, metadata, layer->handle);
+                if (created)
+                    buf = d->buffer_map.emplace(layer->handle, std::move(created)).first->second.get();
+            }
+            if (buf) {
+                win->reset_per_set_state();
+                auto &surface = win->get_next_layer();
+                surface.attach_buffer(*buf);
+                surface.damage_surface(0, 0, INT32_MAX, INT32_MAX);
+                surface.set_buffer_transform(hwc_transform_to_buffer_transform(layer->transform));
+                if (surface.viewport) {
+                    surface.set_crop(rect_apply_transform(layer->sourceCropf, layer->transform));
+                    surface.set_display_frame(layer->displayFrame, d->scale);
+                } else {
+                    surface.set_buffer_scale(d->scale);
+                }
+                if (layer->acquireFenceFd != -1)
+                    sync_wait(layer->acquireFenceFd, acquireWarningMS);
+                wl_surface_commit(surface.surface);
+                wl_surface_commit(win->surface);
+            } else {
+                ALOGE("external display: no wayland buffer for the target");
+            }
+        }
+
+        if (layer->acquireFenceFd != -1) {
+            close(layer->acquireFenceFd);
+            layer->acquireFenceFd = -1;
+        }
+    }
+    wl_display_flush(d->display);
+}
+
 static int hwc_set(struct hwc_composer_device_1* dev,size_t numDisplays,
                    hwc_display_contents_1_t** displays) {
     if (HWC_DISPLAY_PRIMARY >= numDisplays || !displays)
@@ -450,6 +511,9 @@ static int hwc_set(struct hwc_composer_device_1* dev,size_t numDisplays,
 
     auto *pdev = static_cast<waydroid_hwc_composer_device_1 *>(dev);
 
+    if (pdev->ext_display && numDisplays > HWC_DISPLAY_EXTERNAL && displays[HWC_DISPLAY_EXTERNAL])
+        set_external(pdev, displays[HWC_DISPLAY_EXTERNAL]);
+
     hwc_display_contents_1_t* contents = displays[HWC_DISPLAY_PRIMARY];
     assert(contents);
 
@@ -533,7 +597,7 @@ static int hwc_query(struct hwc_composer_device_1 *dev, int what, int *value) {
             value[0] = pdev->vsync_period_ns;
             break;
         case HWC_DISPLAY_TYPES_SUPPORTED:
-            *value = HWC_DISPLAY_PRIMARY;
+            *value = HWC_DISPLAY_PRIMARY_BIT | (pdev->ext_display ? HWC_DISPLAY_EXTERNAL_BIT : 0);
             break;
         default:
             // unsupported query
@@ -549,13 +613,17 @@ static void hwc_register_procs(struct hwc_composer_device_1* dev,
     pdev->procs = procs;
 }
 
-static int hwc_get_display_configs(struct hwc_composer_device_1* dev __unused,
+static bool is_external(struct hwc_composer_device_1* dev, int disp) {
+    return disp == HWC_DISPLAY_EXTERNAL && static_cast<waydroid_hwc_composer_device_1 *>(dev)->ext_display;
+}
+
+static int hwc_get_display_configs(struct hwc_composer_device_1* dev,
                                    int disp, uint32_t* configs, size_t* numConfigs) {
     if (*numConfigs == 0) {
         return 0;
     }
 
-    if (disp == HWC_DISPLAY_PRIMARY) {
+    if (disp == HWC_DISPLAY_PRIMARY || is_external(dev, disp)) {
         configs[0] = 0;
         *numConfigs = 1;
         return 0;
@@ -606,7 +674,22 @@ static int hwc_get_display_attributes(struct hwc_composer_device_1* dev,
                                       const uint32_t* attributes, int32_t* values) {
     auto *pdev = static_cast<waydroid_hwc_composer_device_1 *>(dev);
     for (int i = 0; attributes[i] != HWC_DISPLAY_NO_ATTRIBUTE; i++) {
-        if (disp == HWC_DISPLAY_PRIMARY) {
+        if (is_external(dev, disp)) {
+            struct display *d = pdev->ext_display;
+            switch (attributes[i]) {
+                case HWC_DISPLAY_WIDTH:
+                    values[i] = floor(d->width * d->scale);
+                    break;
+                case HWC_DISPLAY_HEIGHT:
+                    values[i] = floor(d->height * d->scale);
+                    break;
+                default:
+                    values[i] = hwc_attribute(pdev, attributes[i]);
+            }
+            if (values[i] == -EINVAL) {
+                return -EINVAL;
+            }
+        } else if (disp == HWC_DISPLAY_PRIMARY) {
             values[i] = hwc_attribute(pdev, attributes[i]);
             if (values[i] == -EINVAL) {
                 return -EINVAL;
@@ -620,14 +703,14 @@ static int hwc_get_display_attributes(struct hwc_composer_device_1* dev,
     return 0;
 }
 
-static int hwc_get_active_config(struct hwc_composer_device_1* dev __unused, int disp) {
-    if (disp == HWC_DISPLAY_PRIMARY)
+static int hwc_get_active_config(struct hwc_composer_device_1* dev, int disp) {
+    if (disp == HWC_DISPLAY_PRIMARY || is_external(dev, disp))
         return 0;
     return -EINVAL;
 }
 
-static int hwc_set_active_config(struct hwc_composer_device_1* dev __unused, int disp, int index) {
-    if (disp == HWC_DISPLAY_PRIMARY && index == 0)
+static int hwc_set_active_config(struct hwc_composer_device_1* dev, int disp, int index) {
+    if ((disp == HWC_DISPLAY_PRIMARY || is_external(dev, disp)) && index == 0)
         return 0;
     return -EINVAL;
 }
@@ -702,6 +785,18 @@ shutdown:
     return NULL;
 }
 
+static void* hwc_ext_hotplug_thread(void* data) {
+    auto *pdev = static_cast<waydroid_hwc_composer_device_1 *>(data);
+
+    // The client registers its callbacks after open; announce the display once it has
+    while (!pdev->procs || !pdev->procs->hotplug)
+        usleep(100 * 1000);
+    sleep(2);
+    ALOGI("external display: hotplug");
+    pdev->procs->hotplug(pdev->procs, HWC_DISPLAY_EXTERNAL, 1);
+    return NULL;
+}
+
 static int hwc_open(const struct hw_module_t* module, const char* name,
                     struct hw_device_t** device) {
     int ret = 0;
@@ -793,6 +888,23 @@ static int hwc_open(const struct hw_module_t* module, const char* name,
         first_window.reset();
     }
 
+    if (property_get("waydroid.wayland_display_ext", property, nullptr) > 0) {
+        std::string primary_socket = getenv("WAYLAND_DISPLAY");
+        setenv("WAYLAND_DISPLAY", property, 1);
+        pdev->ext_display = create_display(property_get_string("ro.hardware.gralloc", "default").c_str(), true);
+        setenv("WAYLAND_DISPLAY", primary_socket.c_str(), 1);
+        if (pdev->ext_display) {
+            pdev->ext_display->ext_abs_width = floor(pdev->display->width * pdev->display->scale);
+            pdev->ext_display->ext_abs_height = floor(pdev->display->height * pdev->display->scale);
+            pdev->ext_window = window::create(pdev->ext_display, false, "Waydroid", "none", {0, 0, 0, 255});
+            ALOGI("external display %dx%d scale %f", pdev->ext_display->width, pdev->ext_display->height, pdev->ext_display->scale);
+            if (pthread_create(&pdev->ext_hotplug_thread, NULL, hwc_ext_hotplug_thread, pdev))
+                ALOGE("waydroid_hw_composer could not start the external hotplug thread");
+        } else {
+            ALOGE("external display: no compositor at %s", property);
+        }
+    }
+
     pdev->vsync_callback_enabled = true;
     if (pdev->display->refresh > 1000 && pdev->display->refresh < 1000000)
         pdev->vsync_period_ns = 1000 * 1000 * 1000 / (pdev->display->refresh / 1000);
