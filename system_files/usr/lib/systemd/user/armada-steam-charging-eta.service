[Unit]
Description=Publish UPower battery estimates to Steam vpower
PartOf=gamescope-session-plus@steam.service

[Service]
ExecStart=/usr/libexec/armada/armada-steam-charging-eta
ExecStop=/usr/bin/rm -f /run/vpower/ac_status /run/vpower/battery_percent /run/vpower/battery_status /run/vpower/secs_until_battery_full /run/vpower/secs_until_shutdown_request
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
