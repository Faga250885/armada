#!/usr/bin/bash
# Terra's steamos-session-select execs this hook (Steam "Switch to Desktop").
# steamosctl talks to steamos-manager over the caller's own session bus, so
# this needs no sudo/root escalation the way session-control does.
set -euo pipefail

steamosctl=${ARMADA_STEAMOSCTL:-/usr/bin/steamosctl}
qdbus=${ARMADA_QDBUS:-/usr/bin/qdbus-qt6}

# The nested desktop has a session bus of its own, without steamos-manager; its shell quitting ends it.
if [[ -n "${ARMADA_NESTED_DESKTOP:-}" && "${1:-gamescope}" == gamescope ]]; then
    exec "${qdbus}" org.kde.plasmashell /MainApplication org.qtproject.Qt.QCoreApplication.quit
fi

case "${1:-gamescope}" in
    desktop|plasma) exec "${steamosctl}" switch-to-desktop-mode ;;
    gamescope)      exec "${steamosctl}" switch-to-game-mode ;;
    *) echo "unrecognised session: ${1}" >&2; exit 1 ;;
esac
